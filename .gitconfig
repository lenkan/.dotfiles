[user]
	name = lenkan
	signingkey = ~/.ssh/id_ed25519.pub
	email = 5889538+lenkan@users.noreply.github.com
[alias]
	lg1 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
	lg = !"git lg1"
[init]
	defaultBranch = main
[core]
	pager = command -v delta >/dev/null && exec delta || exec less
[interactive]
	diffFilter = command -v delta >/dev/null && exec delta --color-only || exec cat
[delta]
	navigate = true
	keep-plus-minus-markers = true
	plus-style = syntax "#0b3a5c"
	plus-emph-style = syntax "#1d5f8a"
	minus-style = syntax "#5c3a0b"
	minus-emph-style = syntax "#8a5a1d"
[diff]
	tool = nvim_difftool
[difftool]
	prompt = false
# `git difftool -d` shows every changed file in nvim
[difftool "nvim_difftool"]
	cmd = nvim -c \"packadd nvim.difftool\" -c \"DiffTool $LOCAL $REMOTE\"
[gpg]
	format = ssh
[commit]
	gpgSign = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
# Machine-specific overrides, e.g. a work [user]. Must stay last to win.
[include]
	path = ~/.gitconfig.local
